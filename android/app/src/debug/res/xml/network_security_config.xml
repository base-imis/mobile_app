<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of the release policy of the same name. Metro talks to the
  packager over plaintext HTTP, and QA needs user-installed CAs for proxy capture.
  This file is never packaged into a release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
