<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy.
  cleartextTrafficPermitted="false" blocks all plaintext HTTP (VAPT: AND-CLEARTEXT-TRAFFIC).
  Trust anchors are limited to the system CA store so user-installed CAs cannot be
  used to intercept traffic on a compromised or rooted device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
